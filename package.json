    "cmdk": "^1.1.1",
    "domhandler": "^6.0.1",
    "domutils": "^4.0.2",
    "entities": "^8.1.0",
    "htmlparser2": "^12.0.0",
    "next": "^16.4.0",
    "next-themes": "^0.4.6",
    "pg": "^8.23.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sanitize-html": "^2.18.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.3.3",
